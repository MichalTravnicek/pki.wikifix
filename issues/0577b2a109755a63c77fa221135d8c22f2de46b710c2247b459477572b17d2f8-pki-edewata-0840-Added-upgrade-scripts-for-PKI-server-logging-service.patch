diff --git a/base/server/upgrade/10.4.0/01-FixLoggingProperties b/base/server/upgrade/10.4.0/01-FixLoggingProperties
new file mode 100644
index 0000000000000000000000000000000000000000..1dcb51baba507beafe29395276a7e2fe8a9688df
--- /dev/null
+++ b/base/server/upgrade/10.4.0/01-FixLoggingProperties
@@ -0,0 +1,47 @@
