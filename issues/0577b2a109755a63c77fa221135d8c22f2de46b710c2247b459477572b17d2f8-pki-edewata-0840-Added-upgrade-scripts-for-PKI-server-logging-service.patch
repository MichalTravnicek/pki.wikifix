+# All rights reserved.
+
+from __future__ import absolute_import
+import os
+import pki.server.upgrade
+
+
+class FixLoggingProperties(pki.server.upgrade.PKIServerUpgradeScriptlet):
+
+    def __init__(self):
+        super(FixLoggingProperties, self).__init__()
+        self.message = 'Fix logging.properties'
+
+    def upgrade_instance(self, instance):
+
+        logging_properties = os.path.join(instance.conf_dir, 'logging.properties')
+
+        # if <instance>/conf/logging.properties is already a link, skip
+        if os.path.islink(logging_properties):
+            return
+
+        # remove old logging.properties
+        self.backup(logging_properties)
+        os.remove(logging_properties)
+
+        # link <instance>/conf/logging.properties
+        # to /usr/share/pki/server/conf/logging.properties
+        os.symlink('/usr/share/pki/server/conf/logging.properties', logging_properties)
+        os.lchown(logging_properties, instance.uid, instance.gid)
diff --git a/base/server/upgrade/10.4.0/02-RemoveLog4jProperties b/base/server/upgrade/10.4.0/02-RemoveLog4jProperties
