+++ b/base/tps/src/engine/RA.cpp
@@ -3747,13 +3747,23 @@ int RA::get_token_state(char *state, char *reason)
     } else if (strcasecmp(state, STATE_ACTIVE) == 0) {
         ret = TOKEN_FOUND;
     } else if (strcasecmp(state, STATE_LOST) == 0) {
-        if (strcasecmp(reason, "keyCompromise") == 0) {
+        if (reason == NULL) {
+             /* If we can't determine a reason, assume its permanently lost.
+             * This shouldn't happen, but it's possible if the database has
+             * been manually modified. */
+            RA::Debug("RA::get_token_state", "reason is NULL");
+            ret =  TOKEN_PERM_LOST;
+        } else if (strcasecmp(reason, "keyCompromise") == 0) {
             /* perm lost or temp -> perm lost */
             ret =  TOKEN_PERM_LOST;
         } else if (strcasecmp(reason, "destroyed") == 0) {
             ret = TOKEN_DAMAGED;
         } else if (strcasecmp(reason, "onHold") == 0) {
             ret = TOKEN_TEMP_LOST;
+        } else {
+            /* This shouldn't happen.  Assume it is permanently lost. */
+            RA::Debug("RA::get_token_state", "unrecognized reason: \"%s\"", reason);
+            ret = TOKEN_PERM_LOST;
         }
     } else if (strcasecmp(state, "terminated") == 0) {
         ret = TOKEN_TERMINATED;
