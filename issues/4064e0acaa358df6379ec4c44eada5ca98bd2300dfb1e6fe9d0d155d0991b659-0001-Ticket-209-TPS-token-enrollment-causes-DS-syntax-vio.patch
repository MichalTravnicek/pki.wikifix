index 034357b..af77241 100644
--- a/base/common/src/com/netscape/cmscore/usrgrp/UGSubsystem.java
+++ b/base/common/src/com/netscape/cmscore/usrgrp/UGSubsystem.java
@@ -654,7 +654,18 @@ public final class UGSubsystem implements IUGSubsystem {
         attrs.add(new LDAPAttribute("uid", id.getUserID()));
         attrs.add(new LDAPAttribute("sn", id.getFullName()));
         attrs.add(new LDAPAttribute("cn", id.getFullName()));
-        attrs.add(new LDAPAttribute("mail", id.getEmail()));
+
+        if (id.getEmail() != null) {
+            // Older versions of DS used the DirectoryString syntax
+            // for the mail attribute, which requires a value if
+            // syntax checking is enabled.  Current versions of DS
+            // use the IA5String syntax, which allows an empty value.
+            // In either case, we have no need of an empty mail
+            // attribute, so we avoid setting an empty value.
+            if (! id.getEmail().equals("")) {
+                attrs.add(new LDAPAttribute("mail", id.getEmail()));
+            }
+        }
 
         if (id.getPhone() != null) {
             // DS syntax checking requires a value for PrintableString syntax
